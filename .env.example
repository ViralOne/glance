# Protects the dashboard and admin API with a single login. Leave both blank to
# run without a login (only do that behind your own proxy/VPN). Password: 8+ characters.
GLANCE_ADMIN_USER=admin
GLANCE_ADMIN_PASSWORD=change-me-please

# Days of raw events to keep (minimum 2). Hourly and daily rollups are kept
# forever. Raw events are what filtered views and funnels read, so this is how
# far back those reach; 30 is the default.
GLANCE_RETENTION_DAYS=30

GLANCE_LOG_LEVEL=info

# How many reverse proxies sit in front of Glance. Each one appends the address
# it saw to X-Forwarded-For, so the real visitor is that many entries from the
# right; anything further left was sent by the caller and is not trusted.
#   0 (default) - nothing in front, read the peer address and ignore the header
#   1           - Traefik, Caddy, nginx or Cloudflare terminates in front
# Getting this wrong is quiet: too low and every visitor shares the proxy's
# address, too high and a caller can mint a new address per request.
GLANCE_TRUSTED_PROXY_HOPS=0

# Ad blockers match on URL shape, and both "glance.js" and a path ending in
# "/collect" are what filter lists look for. Serving Glance from the same domain
# as the site it measures is the real fix, because a blocker will not break your
# own domain; renaming these closes most of the rest. Both are additional paths,
# so the defaults keep working.
GLANCE_SNIPPET_PATH=
GLANCE_COLLECT_PATH=

# Accept events whose page host looks like a development address (localhost,
# *.test, a LAN IP) even from a public client. The page host comes from the
# request body, so this bypasses the site-domain check for every site: only turn
# it on when the collector is not reachable from the internet.
GLANCE_ALLOW_LOCAL_EVENTS=

# Optional MaxMind-format city database (GeoLite2-City.mmdb or DB-IP City Lite)
# for real cities and regions. Without it, location comes from the visitor's
# time zone, which is honest but country-shaped. Nothing is fetched at runtime.
GLANCE_GEOIP_PATH=

# SMTP, for the weekly digest and email alerts. Without a host, alerts can still
# be delivered to a webhook. TLS is starttls, tls (implicit) or none.
GLANCE_SMTP_HOST=
GLANCE_SMTP_PORT=587
GLANCE_SMTP_USER=
GLANCE_SMTP_PASSWORD=
GLANCE_SMTP_FROM=
GLANCE_SMTP_TLS=starttls

# Glance's own public URL, linked from digests and alerts, where there is no
# request to rebuild it from.
GLANCE_BASE_URL=

# Per-address ingest limits. A zero in either disables the limit.
GLANCE_COLLECT_BURST=120
GLANCE_COLLECT_PER_SECOND=4

# Bearer token for the read-only MCP endpoint (/mcp) that AI agents connect to.
# 16+ characters; leave blank to allow only the admin login there.
GLANCE_MCP_TOKEN=

# OAuth client from Google Cloud for the per-site "Connect Google Search Console"
# button. Register <your glance url>/api/v1/google/callback as the redirect URI.
GLANCE_GOOGLE_CLIENT_ID=
GLANCE_GOOGLE_CLIENT_SECRET=
